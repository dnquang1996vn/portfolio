# Contact form (Resend). Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Where contact-form messages are delivered. On the free plan without a verified domain this
# must be the email of the Resend account owner.
CONTACT_TO=
# Optional sender. Default "Portfolio contact <onboarding@resend.dev>" needs no domain setup;
# set a verified-domain address (e.g. "Quinn Do <contact@yourdomain.com>") once you have one.
# CONTACT_FROM=

# Engagement counters (Upstash Redis / Vercel KV). Optional; falls back to in-memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
